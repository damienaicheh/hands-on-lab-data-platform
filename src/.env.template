# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
API_VERSION=2025-11-01-preview
VECTOR_STORE_ID=<your-vector-store-id>

# --- Indexer polling ---
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_POLL_ATTEMPTS=120

# --- Foundry ---
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-id>
ADVANCED_CHAT_MODEL_DEPLOYMENT="gpt-5.4"
CHAT_MODEL_DEPLOYMENT="gpt-4.1-mini"

# --- Foundry IQ knowledge source / base names ---
AI_SEARCH_KNOWLEDGE_BASE_NAME="ai-search-knowledge-source"
WEB_KNOWLEDGE_SOURCE_NAME="web-knowledge-source"
KNOWLEDGE_BASE_NAME="contoso-knowledge-base"

# --- Azure OpenAI (embeddings) ---
AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
EMBEDDING_DEPLOYMENT="text-embedding-3-large"
EMBEDDING_DIMENSIONS=3072

# --- ADLS Gen2 storage (data source with POSIX ACL ingestion) ---
# Dedicated ADLS Gen2 account created by Terraform (infra/sto_search.tf).
# See Terraform outputs: search_data_blob_endpoint / search_data_resource_id.
BLOB_ACCOUNT_URL=https://<your-adls-gen2-account>.blob.core.windows.net
BLOB_CONTAINER_NAME=data
BLOB_DATASOURCE_CONNECTION_STRING="ResourceId=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<adls-gen2-account>;"
# Local folder with the documents to upload to blob storage (the AI Search JSON
# templates themselves live in ./data and are not configured here).
LOCAL_DATA_DIR=documents



# Microsoft Entra security group whose members can read the 'restricted'
# documents (a subset of participants, e.g. project managers).
RESTRICTED_DOCS_GROUP_ID=<your-restricted-group-id>
# Microsoft Entra security group containing every workshop participant. Its
# members can read the documents outside the 'restricted' folder (the shared,
# "everyone" tier). ADLS Gen2 has no native "public/everyone" ACL category, so
# this group is how the shared documents are exposed to all participants.
ALL_PARTICIPANTS_GROUP_ID=<your-all-participants-group-id>